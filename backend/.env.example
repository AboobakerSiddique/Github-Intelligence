# Server environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# GitHub API access (increases rate limit from 60/hr to 5000/hr)
# Create a fine-grained personal access token with no special scopes needed
# for public repo reads: https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Gemini API key for AI insights: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# CORS: URL of the deployed/local frontend
FRONTEND_URL=http://localhost:3000

# Cache TTL in seconds for GitHub API responses
CACHE_TTL_SECONDS=300
