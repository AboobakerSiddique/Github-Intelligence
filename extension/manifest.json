{
  "manifest_version": 3,
  "name": "GitHub Repository Intelligence",
  "description": "Adds a repository health score badge to GitHub repo pages, powered by GitHub Repository Intelligence.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github-intelligence.onrender.com/*"
  ]
}
